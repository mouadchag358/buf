PAGE_ID=
PAGE_ACCESS_TOKEN=

# Instagram : compte professionnel ; aucun secret dans le dépôt.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# facebook pour un jeton via Facebook Login ; instagram pour Instagram Login.
INSTAGRAM_LOGIN_MODE=facebook
# URL publique du dossier images/instagram, sans authentification.
# Exemple si le serveur est hébergé : https://votre-domaine/media/instagram
INSTAGRAM_MEDIA_BASE_URL=

# Réglages facultatifs
HOST=127.0.0.1
PORT=3000
TIME_ZONE=Africa/Casablanca
CRON_SCHEDULE=0 9,13 * * *
GRAPH_API_VERSION=v26.0
MAX_IMAGE_BYTES=10485760

# Buffer (facultatif) : créez une clé personnelle dans les réglages API Buffer.
BUFFER_API_KEY=Q_oO9EnME7PlJX5fTSL3o1n9f8Cpq9aMpFqwANpARDo
# Recommandé si le compte contient plusieurs organisations ou canaux.
BUFFER_ORGANIZATION_ID=
BUFFER_FACEBOOK_CHANNEL_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=
# Alternative pour sélectionner explicitement plusieurs canaux, séparés par des virgules.
BUFFER_CHANNEL_IDS=
# Dépôt public qui contient les images locales, au format propriétaire/dépôt.
PUBLIC_MEDIA_REPOSITORY=
PUBLIC_MEDIA_REF=main
BUFFER_MAX_SCHEDULED=10
BUFFER_REQUEST_TIMEOUT_MS=30000
