# Secret obligatoire. Dans GitHub : Settings > Secrets and variables > Actions.
BUFFER_API_KEY=

# Identifiants des canaux autorisés.
BUFFER_ORGANIZATION_ID=6a9dd40e7a5c57f938ac3176
BUFFER_FACEBOOK_CHANNEL_ID=6ab674f7ea19ca0bdee54b05
BUFFER_INSTAGRAM_CHANNEL_ID=6ab6749aea19ca0bdee546fa

# GitHub Actions fournit automatiquement GITHUB_REPOSITORY et GITHUB_REF_NAME.
PUBLIC_MEDIA_REPOSITORY=mouadchag358/buf
PUBLIC_MEDIA_REF=main

# Réglages facultatifs.
TIME_ZONE=Africa/Casablanca
BUFFER_MAX_SCHEDULED=10
BUFFER_REQUEST_TIMEOUT_MS=30000
MAX_IMAGE_BYTES=10485760
